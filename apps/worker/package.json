  "name": "fresherflow-worker",
  "version": "1.0.0",
  "description": "Background worker service for FresherFlow",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node\" src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@fresherflow/config": "^1.0.0",
    "@fresherflow/constants": "^1.0.0",
    "@fresherflow/logger": "^1.0.0",
