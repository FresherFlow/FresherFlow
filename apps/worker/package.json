    "@fresherflow/redis": "^1.0.0",
    "@fresherflow/schemas": "^1.0.0",
    "@fresherflow/types": "^1.0.0",
    "@fresherflow/utils": "^1.0.0",
    "bullmq": "^6.0.6",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "resend": "^6.18.1",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.8",
