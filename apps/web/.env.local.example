# Backend API URL
NEXT_PUBLIC_API_URL="http://localhost:5000"
API_URL="http://localhost:5000"
NEXT_PUBLIC_APP_WEB_HOST="app.fresherflow.in"
NEXT_PUBLIC_ADMIN_WEB_HOST="admin.fresherflow.in"
# Keep ingestion UI hidden in production by default.
# NEXT_PUBLIC_ENABLE_ADMIN_INGESTION="false"

# Production example:
# NEXT_PUBLIC_API_URL="https://job-platform-api.onrender.com"

# Web Push public VAPID key (must match API WEB_PUSH_VAPID_PUBLIC_KEY)
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=""

# --- Social Captions: Worker proxy (server-side only, never NEXT_PUBLIC_) ---
# URL of the deployed worker service (e.g. https://fresherflow-worker.onrender.com)
WORKER_URL=""
# Shared secret matching WORKER_SECRET in apps/worker .env
WORKER_SECRET=""

# --- Admin API auth (server-side only, never NEXT_PUBLIC_) ---
# Signs/verifies the admin session JWT used by the /api/admin/** route guards
# (src/lib/server/adminAuth.ts) for the HttpOnly `adminAccessToken` cookie and
# the `Authorization: Bearer` header. Must be the SAME value apps/api signs admin
# tokens with: JWT_ADMIN_SECRET, else JWT_ACCESS_SECRET, else JWT_SECRET.
# A mismatch makes every /api/admin/** call fail closed with 403. Leaving all three
# unset denies every caller with 403 and logs one MISCONFIGURED line server-side.
# In local dev an unset value falls back to the placeholder in packages/utils/src/auth.ts,
# which matches what apps/api uses in dev. For a real deployment, set an explicit value.
JWT_ADMIN_SECRET=""
