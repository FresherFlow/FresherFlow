NEXT_PUBLIC_API_URL="http://localhost:5000"
# Optional split API hosts (recommended in production)
NEXT_PUBLIC_USER_API_URL="http://localhost:5000"
NEXT_PUBLIC_ADMIN_API_URL="http://localhost:5000"
NEXT_PUBLIC_APP_WEB_HOST="app.fresherflow.in"
NEXT_PUBLIC_ADMIN_WEB_HOST="admin.fresherflow.in"
# Keep ingestion UI hidden in production by default.
# Enable only when ingestion is approved for production rollout.
# NEXT_PUBLIC_ENABLE_ADMIN_INGESTION="false"

INGESTION_SERVICE_URL="http://localhost:3005"
INGESTION_SECRET="your-super-secret-access-key-change-this-in-production-min-32-chars"
# Admin session JWT. Used by the /api/admin/** route guards (src/lib/server/adminAuth.ts)
# to verify the HttpOnly `adminAccessToken` cookie AND an `Authorization: Bearer` header.
# Must resolve to the SAME value apps/api signs admin tokens with: JWT_ADMIN_SECRET, else
# JWT_ACCESS_SECRET, else JWT_SECRET. If it resolves to a different value, every admin tool
# call fails closed with 403. If all three are unset, /api/admin/** denies every caller
# with 403 and the server logs one MISCONFIGURED line naming this variable.
# Leave EMPTY and fill it in per deployment. Do NOT copy a placeholder: the dev
# placeholder in packages/utils/src/auth.ts is published in source, and unlike the user
# token secrets, getAdminSecret does not reject it in production — a deployment carrying
# it would accept admin tokens anyone can forge. Generate with: openssl rand -hex 32
JWT_ADMIN_SECRET=""
# Ingestion PostgreSQL database (used directly by /api/admin/discovery data routes).
# Falls back to STAGING_DATABASE_URL and DATABASE_URL when unset.
INGESTION_DATABASE_URL="postgresql://user:password@localhost:5432/fresherflow_jobs?schema=public"
