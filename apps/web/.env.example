[TEMPLATE]
# FresherFlow web — environment template.
#
# One canonical name per setting, grouped by what it is for. Read this file top
# to bottom and you know the whole surface; there is no second list.
#
# Legacy aliases are read by the code so an older deployment keeps working, but
# they are listed only at the bottom and nothing new should use them.
#
# a value left empty falls back to the derived or local default noted on it.

# -----------------------------------------------------------------------------
# URLs the browser needs (inlined at build time — changing one needs a rebuild)
# -----------------------------------------------------------------------------
# Required. The API origin. Also the only absolute destination accepted by the
# login screen's redirect check, so the MCP connect flow breaks without it.
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Optional. Canonical public origin. Used for share links and metadata fallbacks;
# hosts are derived from the request when it is unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Only set these when the API is split by audience.
# NEXT_PUBLIC_USER_API_URL="http://localhost:5000"
# NEXT_PUBLIC_ADMIN_API_URL="http://localhost:5000"
# NEXT_PUBLIC_USE_SEPARATE_ADMIN_API="false"

# -----------------------------------------------------------------------------
# Hosts (server only)
# -----------------------------------------------------------------------------
# Every one of these is derived from the request host when unset, so a standard
# fresherflow.in / app. / admin. / join. deployment needs none of them.
# PUBLIC_WEB_HOST="fresherflow.in"
# APP_WEB_HOST="app.fresherflow.in"
# ADMIN_WEB_HOST="admin.fresherflow.in"
# USER_LOGIN_HOST="app.fresherflow.in"
# JOIN_WEB_HOST="join.fresherflow.in"

# -----------------------------------------------------------------------------
# Admin session
# -----------------------------------------------------------------------------
# Admin session JWT. Used by the /api/admin/** route guards (src/lib/server/adminAuth.ts)
# to verify the HttpOnly `adminAccessToken` cookie AND an `Authorization: Bearer` header.
# Must resolve to the SAME value apps/api signs admin tokens with: JWT_ADMIN_SECRET, else
# JWT_ACCESS_SECRET, else JWT_SECRET. If it resolves to a different value, every admin tool
# call fails closed with 403. If all three are unset, /api/admin/** denies every caller
# with 403 and the server logs one MISCONFIGURED line naming this variable.
# Leave EMPTY and fill it in per deployment. Do NOT copy a placeholder: the dev
# placeholder in packages/utils/src/auth.ts is published in source, and unlike the user
# token secrets, getAdminSecret does not reject it in production — a deployment carrying
# it would accept admin tokens anyone can forge. Generate with: openssl rand -hex 32
JWT_ADMIN_SECRET=""

# -----------------------------------------------------------------------------
# Ingestion service
# -----------------------------------------------------------------------------
INGESTION_SERVICE_URL="http://localhost:3005"
INGESTION_SECRET="your-super-secret-access-key-change-this-in-production-min-32-chars"
# Ingestion PostgreSQL database (used directly by /api/admin/discovery data routes).
# Falls back to STAGING_DATABASE_URL and DATABASE_URL when unset.
INGESTION_DATABASE_URL="postgresql://user:password@localhost:5432/fresherflow_jobs?schema=public"
# Keep ingestion UI hidden in production by default.
# NEXT_PUBLIC_ENABLE_ADMIN_INGESTION="false"

# -----------------------------------------------------------------------------
# Object storage and CDN
# -----------------------------------------------------------------------------
# R2_ENDPOINT=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# CDN_SIGNATURE_SECRET=
# NEXT_PUBLIC_CDN_URL=
# NEXT_PUBLIC_CDN_SIGNATURE_SECRET=

# -----------------------------------------------------------------------------
# Background work and revalidation
# -----------------------------------------------------------------------------
# WORKER_URL=
# WORKER_SECRET=
# REVALIDATE_SECRET_TOKEN=
# SITEMAP_DATA_URL=

# -----------------------------------------------------------------------------
# Firebase (public client config)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# -----------------------------------------------------------------------------
# Optional telemetry and session tuning
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_CF_BEACON_TOKEN=
# NEXT_PUBLIC_SESSION_REVALIDATE_MS=
# NEXT_PUBLIC_SESSION_HINT_COOKIE_MAX_AGE_SECONDS=

# -----------------------------------------------------------------------------
# Legacy aliases (do not use in new configuration)
# -----------------------------------------------------------------------------
# The host values above were read as `PUBLIC_WEB_HOST || NEXT_PUBLIC_PUBLIC_WEB_HOST
# || NEXT_PUBLIC_SITE_URL` and similarly for the other four, which is how the same
# fact ended up with three names. These twins are still accepted:
#   NEXT_PUBLIC_PUBLIC_WEB_HOST, NEXT_PUBLIC_APP_WEB_HOST,
#   NEXT_PUBLIC_ADMIN_WEB_HOST, NEXT_PUBLIC_USER_LOGIN_HOST,
#   NEXT_PUBLIC_JOIN_WEB_HOST
