# FresherFlow web — environment template.
#
# One canonical name per setting, grouped by what it is for, with the default
# the code falls back to written beside it. Read this file top to bottom and you
# know the whole surface; there is no second list.
#
# Required means the feature breaks or fails closed without it. Optional means
# the code derives a working default (request host, local dev origin, or the
# value noted in the comment).
#
# Client vars (NEXT_PUBLIC_*) are inlined into the browser bundle at build time.
# Everything else is server-only (process.env, never sent to the browser).
# Never commit secrets. Leave an optional value empty to use the derived default.

# ━━━ Client (browser bundle) ━━━

# Required. The API origin. Also the only absolute destination accepted by the
# login screen's redirect check, so the MCP connect flow breaks without it.
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Optional. Canonical public origin. Used for share links, metadata fallbacks
# and the CORS origin in next.config.ts. Hosts are derived from the request when
# it is unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Only set these when the API is split by audience. Unless the flag is
# "true", every client and server call uses NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_USER_API_URL="http://localhost:5000"
# NEXT_PUBLIC_ADMIN_API_URL="http://localhost:5000"
# NEXT_PUBLIC_USE_SEPARATE_ADMIN_API="false"

# Optional. Canonical origin for share previews. Defaults to NEXT_PUBLIC_SITE_URL.
# NEXT_PUBLIC_SHARE_BASE_URL=

# Optional. Join host used to build invite links. Unset falls back to the share
# base, then to the current origin.
# NEXT_PUBLIC_JOIN_WEB_HOST=

# Optional, but required when FEED_SOURCE=cdn (the default). CDN base for feed
# snapshots, logos and signed assets. Not needed for FEED_SOURCE=db.
# NEXT_PUBLIC_CDN_URL=

# Every feed URL is derived from the selected feed base; there are no
# per-endpoint URL variables to keep in sync.

# Optional. Firebase web config. The client resolves a development project when
# these are unset; a production deployment must supply its own values.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Admin sign-in hint, and client tuning/telemetry. The defaults are in
# the comments; anything with no default is off when unset.
# NEXT_PUBLIC_ADMIN_EMAIL=
# NEXT_PUBLIC_ALERTS_CACHE_TTL_MS=900000
# NEXT_PUBLIC_ALERTS_FOCUS_COOLDOWN_MS=120000
# NEXT_PUBLIC_FEED_CACHE_TTL_MS=1800000
# NEXT_PUBLIC_SESSION_REVALIDATE_MS=1800000
# NEXT_PUBLIC_SESSION_HINT_COOKIE_MAX_AGE_SECONDS=7776000
# NEXT_PUBLIC_AUTH_VISIBILITY_REFRESH_COOLDOWN_MS=300000
# NEXT_PUBLIC_ADMIN_SESSION_REVALIDATE_MS=1800000
# NEXT_PUBLIC_ADMIN_VISIBILITY_REFRESH_COOLDOWN_MS=300000
# "true" makes the proxy serve maintenance mode.
# NEXT_PUBLIC_MAINTENANCE_MODE="false"
# Server-side Firebase project choice during SSR/build; the browser picks by
# hostname instead. Set "production" in production.
# NEXT_PUBLIC_APP_ENV="development"
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_CF_BEACON_TOKEN=
# NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS="false"
# NEXT_PUBLIC_ENABLE_SPEED_INSIGHTS="false"
# NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# ━━━ Feed source (read on the server) ━━━
#
# Postgres is the source of truth; the CDN serves derived snapshots of it. This
# one flag selects the read path, with no consumer-code change:
#   cdn   (default) — production: CDN snapshots (R2 behind the CDN).
#   db              — local development: API feed routes generated from Postgres.
#                     No signatures and no CDN dependency.
# The value is matched exactly ("cdn", "db"), so do not quote it.
# FEED_SOURCE=cdn

# ━━━ Server only (process.env, never to browser) ━━━

# Optional. API base for the dev /api rewrite. Falls back to NEXT_PUBLIC_API_URL;
# the rewrite itself then defaults to http://localhost:5000.
# API_URL="http://localhost:5000"
# Required for CDN feed reads in server-rendered routes. Keep server-only.
# CDN_SIGNATURE_SECRET=
# PORT=3000
NODE_ENV="development"

# Hosts (server only). Every one is derived from the request host when unset, so
# a fresherflow.in / admin. / join. deployment needs none of them. There is no
# app. subdomain: the signed-in app is served from PUBLIC_WEB_HOST.
# PUBLIC_WEB_HOST="fresherflow.in"
# ADMIN_WEB_HOST="admin.fresherflow.in"
# USER_LOGIN_HOST="fresherflow.in"
# JOIN_WEB_HOST="join.fresherflow.in"

# Optional. Shared parent-domain cookie scope for the session cookies. Unset
# means host-only cookies, which is correct for a single-domain deployment.
# COOKIE_DOMAIN=

# Required for admin sessions. Must resolve to the SAME value apps/api signs
# admin tokens with: JWT_ADMIN_SECRET, else JWT_ACCESS_SECRET, else JWT_SECRET.
# A mismatch makes every /api/admin/** call fail closed with 403. Leave empty and
# set it per deployment. Do NOT copy a placeholder: the dev placeholder in
# packages/utils/src/auth.ts is published in source, and getAdminSecret does not
# reject it in production, so a deployment carrying it accepts forgeable tokens.
# Generate with: openssl rand -hex 32
# JWT_ADMIN_SECRET=""

# Required for signed CDN URLs. Server only: it must never reach the browser.
# Unset leaves CDN URLs unsigned, which the CDN worker rejects for protected
# objects — so set it wherever private assets or version-pinned feeds are served.
# CDN_SIGNATURE_SECRET=

# Ingestion service. INGESTION_SERVICE_URL is optional in development: unset
# falls back to NEXT_PUBLIC_INGESTION_URL, then the INGESTION_URL alias, then
# http://localhost:3005 (search is disabled in production when none is set).
# INGESTION_SECRET falls back to JWT_ACCESS_SECRET, then JWT_SECRET; when all
# are unset the proxied calls go out unauthenticated.
# INGESTION_SERVICE_URL="http://localhost:3005"
# INGESTION_SECRET=
# Ingestion PostgreSQL database for the legacy ingestion reads. Falls back to
# STAGING_DATABASE_URL, then DATABASE_URL.
# INGESTION_DATABASE_URL=
# Optional. Public base the ingestion CDN previews link to.
# ATS_CDN_BASE=

# Background work and ISR revalidation. WORKER_URL/WORKER_SECRET drive the admin
# social routes, which answer 503 when WORKER_URL is unset.
# REVALIDATE_SECRET_TOKEN gates POST /api/revalidate; that route answers 500
# while it is unset.
# WORKER_URL=
# WORKER_SECRET=
# REVALIDATE_SECRET_TOKEN=

# Object storage (signed reads). All four are needed together.
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Firebase Admin (server only). FIREBASE_PROJECT_ID falls back to
# NEXT_PUBLIC_FIREBASE_PROJECT_ID. All three are required for admin auth.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Basic auth for the cap./disco./discovery. subdomains. Both must be set; with
# either unset, no credentials can match and those hosts answer 401.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
