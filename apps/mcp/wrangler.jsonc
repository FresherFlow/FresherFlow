{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fresherflow-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "FRESHERFLOW_API_URL": "https://api.fresherflow.in",
    "PUBLIC_SITE_URL": "https://fresherflow.in",
    "MCP_PUBLIC_URL": "https://mcp.fresherflow.in",
  },
  "routes": [{ "pattern": "mcp.fresherflow.in", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
}
