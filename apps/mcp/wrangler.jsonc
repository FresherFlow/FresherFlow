{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fresherflow-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mcp.fresherflow.in", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
}
