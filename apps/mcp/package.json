{
  "name": "fresherflow-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server exposing FresherFlow job discovery, submissions, listings and moderation over the existing API",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "smoke:local": "node scripts/smoke-local.mjs",
    "deploy": "wrangler deploy",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "wrangler": "^3.99.0"
  }
}
