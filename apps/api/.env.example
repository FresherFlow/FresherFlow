# Database
DATABASE_URL="postgresql://user:password@localhost:5432/job_platform?schema=public"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/job_platform?schema=public"
INGESTION_DATABASE_URL="postgresql://user:password@localhost:5432/job_platform_ingestion?schema=public"

# JWT Secrets (Change these in production!)
JWT_SECRET="your-super-secret-access-key-minimum-32-characters-long"
JWT_ACCESS_SECRET="your-super-secret-access-key-minimum-32-characters-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-minimum-32-characters-long"
JWT_ADMIN_SECRET="your-super-secret-access-key-minimum-32-characters-long"
ADMIN_ACCESS_TOKEN_EXPIRY="7d"
ADMIN_ACCESS_COOKIE_DAYS="7"

# Frontend URL (used for CORS)
FRONTEND_URL="http://localhost:3000"
FRONTEND_URLS="http://localhost:3000"
# Allow https://*.fresherflow.in automatically in production CORS checks
CORS_ALLOW_FRESHERFLOW_SUBDOMAINS="true"
# Cookie domain for cross-subdomain auth (e.g. .fresherflow.in)
COOKIE_DOMAIN=""
# Strict cookie domains for specific service isolation (Production only)
# Ensures session cookies are not leaked between landing, app, and admin subdomains.
AUTH_COOKIE_DOMAIN=""
ADMIN_COOKIE_DOMAIN=""
REDIS_URL=""

# Environment
NODE_ENV="development"
APP_MODE="all" # all | user | admin
# Public feed teaser cap for unauthenticated users
# Full feed requires login; guests see first N items only.
GUEST_FEED_LIMIT="12"

# Optional: Sentry for error tracking
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# Email delivery (Resend)
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
# Global kill switch to suppress all email sending from this environment
# ENABLE_EMAIL_SENDING="true"
# Use your verified domain sender in production
# EMAIL_FROM="FresherFlow <no-reply@fresherflow.in>"

# Telegram Bot Configuration (Optional)
# TELEGRAM_BOT_TOKEN="replace-with-telegram-bot-token"
# TELEGRAM_ADMIN_CHAT_ID="-1001234567890"
# TELEGRAM_PUBLIC_CHANNEL="@fresherflow_jobs"  # Optional: For broadcasting to public

# Web Push (Required for browser push notifications)
# Generate once: node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:support@fresherflow.in"

# Cron auth (required for GitHub Actions cron endpoints)
# CRON_SECRET="set-a-long-random-secret"

# Infrastructure Gating (Lean Mode)
# Global master switch for background tasks (Expiry, Alerts, Verification)
ENABLE_CRON_TASKS="false"
# Per-task switches. Every one of these defaults to FALSE when unset, and the cron
# endpoint answers 202 {skipped:true} instead of failing, so a task that was never
# enabled is silent rather than loud. Set a task's flag to "true" to actually run it.
#   ENABLE_CRON_EXPIRE     -> job expiry cycle, which also sends the profile boost
#                             reminders ("your recruiter boost ends tomorrow"). Note the
#                             public page itself never expires — the flag owes its name
#                             to when it did; it controls the 7-day boost mail only.
#   ENABLE_CRON_ALERTS     -> saved-search and job alert delivery
#   ENABLE_LINK_VERIFICATION -> dead-link sweep
#   ENABLE_INGESTION_CRON  -> due-source ingestion
ENABLE_CRON_EXPIRE="false"
# Master switch for health endpoints (Set false to stop uptime monitoring hits from waking Render)
ENABLE_HEALTH_CHECK="true"
# Instruction: Set 'ENABLE_CRON_TASKS' in GitHub Variables to control GHA automation.
ENABLE_GHA="false" # Set true in GitHub Actions variables to enable automated crons

ENABLE_EMAIL_SENDING="true"
ENABLE_TELEGRAM_BROADCAST="false"
ENABLE_SOCIAL_POSTING="false"
ENABLE_PUSH_NOTIFICATIONS="false"
ENABLE_INGESTION="false"
ENABLE_LINK_VERIFICATION="false"

# Maintenance Thresholds (Days/Hours)
STALE_LISTING_DAYS="30"
PRUNE_RAW_OPPORTUNITY_DAYS="14"
PRUNE_LOGS_DAYS="30"
CLOSING_SOON_WINDOW_HOURS="48"
USERNAME_COOLDOWN_DAYS="30"

# Internal API URL used by the worker to dispatch cron tasks via HTTP
# Must match the API deployment URL (no trailing slash)
# Example for Railway: INTERNAL_API_URL="https://api-production.up.railway.app"
# Example for local dev: INTERNAL_API_URL="http://localhost:4000"
# INTERNAL_API_URL=""


# Link verification bot config
# VERIFICATION_CRON_SCHEDULE="0 21 * * *" (Once daily)
VERIFICATION_LOOKBACK_HOURS="72"
VERIFICATION_BATCH_SIZE="20"

# Expiry cron config
# EXPIRY_CRON_SCHEDULE="30 18 * * *" (Once daily)
EXPIRY_CRON_TIMEZONE="Asia/Kolkata"

# Alerts limits
# ALERTS_CRON_SCHEDULE="30 2,14 * * *" (Twice daily)
ALERTS_MAX_USERS="250"
ALERTS_MAX_OPPORTUNITIES="120"
ALERTS_MAX_EVENTS="80"

# Public Feed Cache & Limits
PUBLIC_FEED_MAX_LIMIT="200"
PUBLIC_FEED_MAX_PAGE="50"
PUBLIC_FEED_CACHE_TTL_SECONDS="21600"
PUBLIC_DETAIL_CACHE_TTL_SECONDS="21600"

# Ingestion worker/cron (optional)
# Keep disabled on API service and enable on dedicated worker service.
# INGESTION_CRON_ENABLED="false"
# INGESTION_CRON_SCHEDULE="*/20 * * * *"
# INGESTION_DEFAULT_ADMIN_ID="<admin-user-id-for-draft-posting>"
# INGESTION_FRESHER_SCORE_MIN="35"
# INGESTION_HIGH_CONFIDENCE_SCORE="55"
# INGESTION_WORKER_TOKEN="set-a-long-random-token-for-cloudflare-email-worker"
# INTERNAL_TRACKING_EMAILS="admin@fresherflow.in,test@fresherflow.in"
# Safety: keep ingestion API disabled in production until pipeline is finalized.
# Set true only when ingestion is production-ready.
# INGESTION_ENABLE_IN_PROD="false"

# Cloudflare R2 CDN Static Feed Publish Pipeline
R2_ENDPOINT="https://<cloudflare-account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="fresherflow-cdn"

# Readiness probe + graceful shutdown (see src/utils/readiness.ts)
# READINESS_PROBE_TIMEOUT_MS="2000"
# SHUTDOWN_TIMEOUT_MS="10000"

# Secure Automated Ingestion Pipeline
INTERNAL_API_SECRET="your-secure-internal-api-key-here"

# Admin identity + bootstrap (see src/routes/admin/auth.ts)
# ADMIN_EMAIL="admin@fresherflow.in"
# ADMIN_BOOTSTRAP_SECRET="set-a-long-random-secret-for-first-admin-provisioning"
# ADMIN_FRONTEND_URL="https://admin.fresherflow.in"
# Public site URLs used for links, sitemaps and CORS derivations
# PUBLIC_WEB_URL="https://fresherflow.in"
# PUBLIC_FRONTEND_URL="https://fresherflow.in"
# APP_WEB_URL="https://app.fresherflow.in"
# APP_FRONTEND_URL="https://app.fresherflow.in"
# ADMIN_WEB_URL="https://admin.fresherflow.in"
# ADMIN_WEB_HOST="admin.fresherflow.in"
# SITE_URL="https://fresherflow.in"
# SOCIAL_FRONTEND_URL="https://fresherflow.in"
# Extra allowed CORS origins (comma-separated, in addition to FRONTEND_URLS)
# ALLOWED_ORIGINS="https://staging.fresherflow.in"

# Firebase Admin SDK (mobile auth + push; omit to run without Firebase)
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google OAuth (see src/routes/auth.ts)
# GOOGLE_CLIENT_ID=""

# WebAuthn / passkeys (see src/routes/authPasskeys.ts)
# RP_ID="fresherflow.in"

# Next.js revalidation proxy (see src/routes/admin/system.ts)
# REVALIDATE_SECRET_TOKEN=""

# Standalone ingestion service proxy (see src/routes/admin/targets.ts)
# INGESTION_URL="http://localhost:3005"
# INGESTION_SECRET=""

# Redis kill-switch: "false" runs API/rate-limiting without Redis (tests, degraded mode)
# REDIS_ENABLED="true"

# Refresh-token pruning window (see src/cron/expiryCron.ts)
# PRUNE_REFRESH_TOKENS_DAYS="7"

# Feed refresh debounce (see src/infrastructure/events/DiscoveryEmitter.ts)
# FEED_REFRESH_DEBOUNCE_MS="5000"

# Cap on new-job alerts per user per day
# MAX_NEW_JOB_ALERTS_PER_USER_PER_DAY=""

# Intro-request webhook + rate limit (recruiter flow)
# INTRO_REQUEST_WEBHOOK_URL=""
# INTRO_REQUEST_RATE_LIMIT_MAX=""

# Social auto-posting kill-switch
# SOCIAL_AUTO_POST_ENABLED="false"

# Telegram dev-mode + error-report cooldown
# TELEGRAM_ALLOW_DEV="false"
# TELEGRAM_ERROR_COOLDOWN_MINUTES=""

# R2 CDN base URL for public feed objects
# R2_CDN_BASE_URL="https://cdn.fresherflow.in"

# Live-DB smoke tests (vitest): only set in a throwaway environment, never CI/prod
# LIVE_DB_TESTS="false"
