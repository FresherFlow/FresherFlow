{
  "name": "fresherflow-api",
  "version": "1.0.0",
  "description": "Production-grade backend for Job & Walk-in Opportunity Platform",
  "main": "dist/index.js",
  "scripts": {
    "prune:api": "turbo prune fresherflow-api --docker",
    "dev": "nodemon --exec \"tsx\" src/index.ts",
    "dev:worker": "nodemon --exec \"tsx\" src/worker.ts",
    "build": "pnpm run build:deps && tsc && node ../../scripts/copy-parser-runtime.mjs",
    "build:deps": "pnpm --filter @fresherflow/types build && pnpm --filter @fresherflow/constants build && pnpm --filter @fresherflow/logger build && pnpm --filter @fresherflow/config build && pnpm --filter @fresherflow/utils build && pnpm --filter @fresherflow/schemas build && pnpm --filter @fresherflow/database build && pnpm --filter @fresherflow/search build && pnpm --filter @fresherflow/domain build && pnpm --filter @fresherflow/parser build",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "db:push": "prisma db push --schema=../../packages/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=../../packages/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=../../packages/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=../../packages/database/prisma/schema.prisma --config=../../packages/database/prisma.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build:api": "pnpm run build",
    "start:api": "pnpm run start",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "jobs",
    "walk-ins",
    "opportunities"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@bull-board/api": "^8.5.0",
    "@bull-board/express": "^8.5.0",
    "@fresherflow/auth": "^0.0.0",
    "@fresherflow/config": "^1.0.0",
    "@fresherflow/constants": "^1.0.0",
    "@fresherflow/database": "^1.0.0",
    "@fresherflow/domain": "^1.0.0",
    "@fresherflow/logger": "^1.0.0",
    "@fresherflow/parser": "^1.0.0",
    "@fresherflow/queue": "^1.0.0",
    "@fresherflow/redis": "^1.0.0",
    "@fresherflow/schemas": "^1.0.0",
    "@fresherflow/search": "^1.0.0",
    "@fresherflow/types": "^1.0.0",
    "@fresherflow/utils": "^1.0.0",
    "@prisma/client": "^7.9.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^10.69.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "chalk": "^6.0.0",
    "compromise": "^14.16.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.2.0",
    "fuse.js": "^7.5.0",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "natural": "^8.1.1",
    "node-cron": "^4.6.0",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "satori": "^0.29.0",
    "twitter-api-v2": "^1.29.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
