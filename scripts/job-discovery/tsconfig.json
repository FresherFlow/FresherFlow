{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@fresherflow/parser/metadata": ["../../packages/parser/src/metadata.ts"],
      "@fresherflow/parser": ["../../packages/parser/src/index.ts"],
      "@fresherflow/types": ["../../packages/types/src/index.ts"],
      "@fresherflow/constants": ["../../packages/constants/index.ts"],
      "@fresherflow/utils": ["../../packages/utils/src/index.ts"],
      "@fresherflow/utils/*": ["../../packages/utils/src/*"],
    }
  },
  "include": ["src/**/*", "index.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test_pipeline_run.ts",
    "src/pipeline/filter_strict_interns.ts",
    "src/pipeline/run_greenhouse_official.ts"
  ]
}
