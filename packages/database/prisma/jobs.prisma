// ============================================================================
// FRESHERFLOW JOBS PIPELINE DATABASE SCHEMA (DISCOVERY, REGISTRY, PROCESSOR)
// ============================================================================
// NOTE: This schema represents the Jobs Database used by the Search Bot,
// Job Discovery Pipeline, ATS Registry, and Job Processor.
// ============================================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../dist/discovery-client"
}

// ----------------------------------------------------------------------------
// ENUMS FOR STRICT TYPING
// ----------------------------------------------------------------------------

enum CompanyVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AtsProvider {
  GREENHOUSE
  LEVER
  WORKDAY
  ASHBY
  SMARTRECRUITERS
  KEKA
  DARWINBOX
  BAMBOOHR
  ORACLE
  ICIMS
  RECRUITEE
  WORKABLE
  CUSTOM
}

enum AtsHealthStatus {
  HEALTHY
  DEGRADED
  FAILING
  UNKNOWN
}

enum DiscoveredJobStatus {
  DISCOVERED
  PENDING
  PROCESSED
  REJECTED
  EXPIRED
}

enum ProcessedJobStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  EXPIRED
}

// ----------------------------------------------------------------------------
// 1. JOB DISCOVERY PIPELINE TABLES
// ----------------------------------------------------------------------------

model DiscoveredJob {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId               String?              @map("run_id") @db.Uuid
  companyId           String?              @map("company_id")
  
  // Origin & Source
  source              String               // e.g. "ConsiderVC (Nexus VP)", "GetroVC (Blume)"
  sourceType          String               @map("source_type") // "AGGREGATOR", "DIRECT_ATS", "BOARD"
  site                String?
  sourceUrl           String?              @map("source_url")
  externalId          String?              @map("external_id")
  atsId               String?              @map("ats_id")
  boardToken          String?              @map("board_token")
  descriptionSource   String?              @map("description_source")

  // Company Information
  company             String
  companyUrl          String?              @map("company_url")
  companyUrlDirect    String?              @map("company_url_direct")
  companyIndustry     String?              @map("company_industry")
  companyDescription  String?              @map("company_description")
  companyLogo         String?              @map("company_logo")
  companyNumEmployees String?              @map("company_num_employees")
  companyRevenue      String?              @map("company_revenue")
  companyRating       Float?               @map("company_rating")
  companyReviewsCount Int?                 @map("company_reviews_count")
  companyAddresses    String?              @map("company_addresses")
  companyStage        String?              @map("company_stage")
  bannerPhotoUrl      String?              @map("banner_photo_url")

  // Role Details
  title               String
  description         String?
  location            String?
  locationCountry     String?              @map("location_country")
  locationCity        String?              @map("location_city")
  locationRegion      String?              @map("location_region")
  isRemote            Boolean?             @map("is_remote")
  employmentType      String?              @map("employment_type")
  jobType             String?              @map("job_type")
  listingType         String?              @map("listing_type")
  jobLevel            String?              @map("job_level")
  jobFunction         String?              @map("job_function")
  workFromHomeType    String?              @map("work_from_home_type")
  department          String?
  team                String?

  // URLs
  applyLink           String               @map("apply_link")
  applyUrl            String?              @map("apply_url")
  jobUrlDirect        String?              @map("job_url_direct")

  // Eligibility & Matching
  postedAt            DateTime?            @map("posted_at") @db.Timestamptz
  batchYear           String?              @map("batch_year")
  degree              String?
  experienceLevel     String?              @map("experience_level")
  experienceRange     String?              @map("experience_range")
  experienceYears     String?              @map("experience_years")
  vacancyCount        Int?                 @map("vacancy_count")
  skills              String?              // JSON array
  tags                String[]             @default([])
  emails              String?              // JSON array
  fresherScore        Int?                 @map("fresher_score")
  reviewRequired      Boolean?             @map("review_required")

  // Compensation
  salaryMin           Float?               @map("salary_min")
  salaryMax           Float?               @map("salary_max")
  salaryCurrency      String?              @map("salary_currency")
  salaryInterval      String?              @map("salary_interval")
  salarySource        String?              @map("salary_source")
  
  // Walk-in Map Specific Fields
  venueAddress        String?              @map("venue_address")
  clusterName         String?              @map("cluster_name")
  latitude            Float?
  longitude           Float?
  walkinDate          String?              @map("walkin_date")
  walkinTime          String?              @map("walkin_time")
  reportingTime       String?              @map("reporting_time")
  contactPerson       String?              @map("contact_person")
  contactPhone        String?              @map("contact_phone")
  requiredDocs        String?              @map("required_docs") // JSON array

  // Lifecycle
  status              String?              @default("DISCOVERED")
  createdAt           DateTime?            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime?            @default(now()) @map("updated_at") @db.Timestamptz
  lastSeenAt          DateTime?            @default(now()) @map("last_seen_at") @db.Timestamptz

  // Relations
  companyRef          Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  discoveryRun        DiscoveryRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)
  processedJobs       ProcessedJob[]

  @@unique([source, applyLink])
  @@map("discovered_jobs")
  @@index([source])
  @@index([status])
  @@index([company])
  @@index([companyId])
  @@index([applyLink])
  @@index([postedAt])
}

model DiscoveryRun {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt      DateTime?       @default(now()) @map("started_at") @db.Timestamptz
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz
  durationMs     BigInt?         @map("duration_ms")
  totalFound     Int?            @map("total_found")
  accepted       Int?
  reviewRequired Int?            @map("review_required")
  duplicates     Int?
  failed         Int?
  status         String?
  metadata       Json?

  discoveredJobs DiscoveredJob[]

  @@map("discovery_runs")
}

// ----------------------------------------------------------------------------
// 2. COMPANY & ATS REGISTRY DOMAIN TABLES
// ----------------------------------------------------------------------------

model Company {
  id                 String                    @id @default(cuid())
  name               String
  slug               String                    @unique
  website            String?
  careersUrl         String?                   @map("careers_url")
  logo               String?
  industry           String?
  industryTags       String[]                  @default([]) @map("industry_tags")
  topics             String[]                  @default([])
  stage              String?                   // Seed, Series A, Series B, Public, etc.
  size               String?                   // Headcount / size bracket
  headquarters       String?
  verificationStatus CompanyVerificationStatus @default(UNVERIFIED) @map("verification_status")
  active             Boolean                   @default(true)
  createdAt          DateTime?                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?                 @updatedAt @map("updated_at") @db.Timestamptz

  atsSources         CompanyATS[]
  statistics         CompanyStatistics?
  discoveredJobs     DiscoveredJob[]
  processedJobs      ProcessedJob[]

  @@map("companies")
  @@index([slug])
  @@index([name])
}

model CompanyATS {
  id           String          @id @default(cuid())
  companyId    String          @map("company_id")
  provider     AtsProvider
  apiEndpoint  String?         @map("api_endpoint")
  boardToken   String?         @map("board_token")
  careerUrl    String          @map("career_url")
  enabled      Boolean         @default(true)
  lastSync     DateTime?       @map("last_sync") @db.Timestamptz
  nextSync     DateTime?       @map("next_sync") @db.Timestamptz
  failureCount Int             @default(0) @map("failure_count")
  health       AtsHealthStatus @default(UNKNOWN)
  createdAt    DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime?       @updatedAt @map("updated_at") @db.Timestamptz

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_ats")
  @@unique([companyId, provider])
  @@index([companyId])
  @@index([health, enabled])
}

model CompanyStatistics {
  id              String     @id @default(cuid())
  companyId       String     @unique @map("company_id")
  totalJobs       Int        @default(0) @map("total_jobs")
  avgJobsPerMonth Float      @default(0) @map("avg_jobs_per_month")
  lastHiringDate  DateTime?  @map("last_hiring_date") @db.Timestamptz
  medianSalary    Int?       @map("median_salary")
  freshersScore   Int        @default(0) @map("freshers_score")
  updatedAt       DateTime?  @updatedAt @map("updated_at") @db.Timestamptz

  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_statistics")
}

// ----------------------------------------------------------------------------
// 3. JOB PROCESSOR TABLES
// ----------------------------------------------------------------------------

model ProcessedJob {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discoveredJobId        String?            @map("discovered_job_id") @db.Uuid
  companyId              String?            @map("company_id")
  
  // Core Identity
  type                   String             // 'JOB', 'INTERNSHIP', 'WALKIN', 'GOVT'
  title                  String
  company                String
  companyWebsite         String?            @map("company_website")
  companyLogoUrl         String?            @map("company_logo_url")
  companyStage           String?            @map("company_stage")
  description            String
  
  // Eligibility Arrays (Clean structure)
  allowedDegrees         String[]           @default([]) @map("allowed_degrees")
  allowedCourses         String[]           @default([]) @map("allowed_courses")
  allowedSpecializations String[]           @default([]) @map("allowed_specializations")
  allowedPassoutYears    String[]           @default([]) @map("allowed_passout_years")
  requiredSkills         String[]           @default([]) @map("required_skills")
  tags                   String[]           @default([])
  locations              String[]           @default([])
  
  // JSON structures
  structuredLocations    Json?              @map("structured_locations")
  applicationDetails     Json?              @map("application_details")
  walkInDetails          Json?              @map("walk_in_details")
  
  // Metadata & Taxonomy
  workMode               String?            @map("work_mode")
  experienceMin          Int?               @default(0) @map("experience_min")
  experienceMax          Int?               @default(0) @map("experience_max")
  salaryRange            String?            @map("salary_range")
  salaryAmount           String?            @map("salary_amount")
  salaryPeriod           String?            @default("YEARLY") @map("salary_period")
  stipend                String?
  employmentType         String?            @map("employment_type")
  jobFunction            String?            @map("job_function")
  
  // Hiring & Workflow
  incentives             String?
  selectionProcess       String?            @map("selection_process")
  notesHighlights        String?            @map("notes_highlights")
  
  // Links
  applyLink              String             @map("apply_link")
  sourceUrl              String?            @map("source_url")
  customSlug             String?            @unique @map("custom_slug")
  
  // State
  status                 String?            @default("PENDING_REVIEW")
  createdAt              DateTime?          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime?          @default(now()) @map("updated_at") @db.Timestamptz

  // Relations
  discoveredJob          DiscoveredJob?     @relation(fields: [discoveredJobId], references: [id], onDelete: SetNull)
  companyRef             Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@map("processed_jobs")
  @@index([status])
  @@index([company])
  @@index([companyId])
  @@index([applyLink])
}
