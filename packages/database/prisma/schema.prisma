enum ApplicationStatus {
  APPLIED
  ASSESSMENT_RECEIVED
  ASSESSMENT_COMPLETED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  SELECTED
  REJECTED
  WAITING
