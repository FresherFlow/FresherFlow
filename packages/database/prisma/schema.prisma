// ============================================================================
// COMMUNITY POST MODELS
// ============================================================================

model CommunityPost {
  id              String                @id @default(cuid())
  authorId        String
  author          User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title           String
  body            String                @db.Text
  category        CommunityPostCategory @default(DISCUSSION)
  tags            String[]              @default([])
  isAnonymous     Boolean               @default(false)
  anonId          String?
  likesCount      Int                   @default(0)
  commentsCount   Int                   @default(0)
  status          CommunityPostStatus   @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  expiredAt       DateTime?
  sourceOpportunityId String?
  roomId          String?

  room            Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  comments        CommunityPostComment[]
  votes           CommunityPostVote[]
  reports         Report[]

  @@index([createdAt])
  @@index([category])
  @@index([status])
  @@index([authorId])
  @@index([sourceOpportunityId])
  @@index([roomId])
  @@index([tags], type: Gin)
}

model CommunityPostComment {
  id          String                @id @default(cuid())
  postId      String
  post        CommunityPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      CommunityPostComment? @relation("CommentReplies", fields: [parentId], references: [id])
  body        String                @db.Text
  isAnonymous Boolean               @default(false)
  anonId      String?
  likesCount  Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  replies     CommunityPostComment[] @relation("CommentReplies")
  votes       CommunityPostVote[]
  reports     Report[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model CommunityPostVote {
  id        String   @id @default(cuid())
  postId    String?
  commentId String?
  userId    String
  value     Int      // 1 or -1
  createdAt DateTime @default(now())

  post    CommunityPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment CommunityPostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([commentId, userId])
  @@index([userId])
}

