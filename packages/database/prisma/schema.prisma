// ============================================================================
// PHASE 3: ROOMS (Persistent Communities)
// ============================================================================

// A Room is not a CommunityPost, so it gets its own lifecycle enum rather than
// borrowing CommunityPostStatus.
enum RoomStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum RoomMemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

model Room {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String   @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(10)
  // A room is a COMMUNITY, not a saved search. It is described by free-form
  // tags: #2026, #mca, #swe, #hyderabad, #tcs. This replaces a RoomType enum
  // plus a structured criteria object, which turned rooms into a third matching
  // system alongside SavedSearch and forced a single dimension per room.
  // One room can now span company + batch + role at once.
  tags        String[] @default([])
  memberCount Int      @default(0)
  postCount   Int      @default(0)
  // Not "jobCount": the platform also carries competitions, scholarships,
  // education and events.
  opportunityCount Int @default(0)
  isPublic    Boolean  @default(true)
  status      RoomStatus @default(ACTIVE)
  createdByUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  members   RoomMember[]
  posts     CommunityPost[]
  // Opportunities this group surfaces, by deliberate sharing or curation.
  // Without this join, the counter above was an integer nobody could maintain
  // or query.
  opportunities RoomOpportunity[]

  @@index([slug])
  @@index([tags], type: Gin)
  @@index([memberCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])

  @@map("areas")
}

// Opportunities deliberately surfaced inside a community. They are shared or
// curated by members and moderators — NOT automatically matched from the room's
// tags. Personal matching is SavedSearch's job; a room is a place people gather.
// Room.opportunityCount is a denormalised counter of these rows.
enum RoomOpportunityReason {
  // MATCHED is deliberately gone. Automatic surfacing belongs to SavedSearch
  // (personal matching) and a future recommendation engine, not to the room.
  PINNED   // an owner or moderator curated it to the top
  SHARED   // a member shared it into the community
}

model RoomOpportunity {
  roomId        String
  opportunityId String
  reason        RoomOpportunityReason @default(SHARED)
  addedByUserId String?
  createdAt     DateTime      @default(now())

  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  addedBy     User?       @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@id([roomId, opportunityId])
  @@index([opportunityId])
  @@index([roomId, reason])
}

model RoomMember {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  role      RoomMemberRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])

  @@map("area_members")
}

// ============================================================================
// FRESHER NEEDS: Saved searches, referrals board, offer transparency
// ============================================================================

enum ReferralRequestStatus {
  OPEN
  FULFILLED
  CLOSED
}

// ── Hiring pipeline ───────────────────────────────────────────────────────────
// A hiring process is an ORDERED LIST OF STAGES that differs per company: one
// firm runs screening, two technical rounds, then HR and an offer; another runs
// a coding assessment and a case study. Encoding that as a fixed enum is what
// made the lifecycle vocabulary grow forever, so the concrete steps are DATA.
//
// RecruitmentStageKind stays a small, stable vocabulary (it is the axis we want
// to filter and report on). Everything company-specific — how many rounds, what
// they are called, how long each takes — lives in RecruitmentStage rows.
enum RecruitmentStageKind {
  SCREENING
  ASSESSMENT
  INTERVIEW
  CASE_STUDY
  GROUP_EXERCISE
  OFFER
  TRAINING
  ONBOARDING
  OTHER
}

model HiringPipeline {
  id             String        @id @default(uuid())
  // The organisation that owns this process. Null for the platform default
  // template, which is used for scraped listings whose employer has no account.
  organizationId String?
  organization   Organization? @relation("OrganizationPipelines", fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean       @default(false)
  // The platform-supplied template, not editable by an organisation.
  isTemplate     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  stages        RecruitmentStage[]
  opportunities Opportunity[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RecruitmentStage {
  id           String               @id @default(uuid())
  pipelineId   String
  kind         RecruitmentStageKind
  // Company-specific label: "Technical round 2", "Case study", "Onboarding".
  name         String
  order        Int
  expectedDays Int?

  pipeline     HiringPipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  applications OpportunityApplication[]

  @@unique([pipelineId, order])
  @@index([kind])
  @@index([pipelineId, order])
}

model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  name        String   @db.VarChar(100)
  // Serialized filter combo (type, city, batch, tags, minSalary, feedType, ...)
  filters     Json
  alertEnabled Boolean @default(true)
  lastMatchedAt DateTime?
  lastNotifiedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutions SavedSearchInstitution[]

  @@index([userId])
  @@index([alertEnabled, lastNotifiedAt])
}

model ReferralRequest {
  id          String   @id @default(cuid())
  authorId    String
  company     String   @db.VarChar(120)
  role        String?  @db.VarChar(120)
  batch       Int?
  city        String?  @db.VarChar(80)
  note        String?  @db.VarChar(1000)
  status      ReferralRequestStatus @default(OPEN)
  responseCount Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User              @relation("ReferralRequestAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  responses ReferralResponse[]

  @@index([company])
  @@index([status, createdAt(sort: Desc)])
  @@index([authorId])
}

model ReferralResponse {
  id              String   @id @default(cuid())
  requestId       String
  responderId     String
  message         String?  @db.VarChar(1000)
  contactHandle   String?  @db.VarChar(200) // email / LinkedIn / Telegram handle shared by responder
  createdAt       DateTime @default(now())

  request ReferralRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responder User          @relation("ReferralResponseAuthor", fields: [responderId], references: [id], onDelete: Cascade)

  @@unique([requestId, responderId])
  @@index([responderId])
}

enum SalaryReportType {
  OFFER
  CURRENT_CTC
}

model SalaryReport {
  id           String   @id @default(cuid())
  authorId     String
  opportunityId String?
  company      String   @db.VarChar(120)
  role         String   @db.VarChar(120)
  batch        Int?
  city         String?  @db.VarChar(80)
  reportType   SalaryReportType @default(OFFER)
  ctcFixed     Int?     // Fixed pay in INR thousands (e.g. 350 = 3.5 LPA)
  ctcVariable  Int?     // Variable/bonus in INR thousands
  ctcTotal     Int?     // Stated CTC in INR thousands
  inHandMonthly Int?    // Take-home per month in INR
  joinBonus    Int?     // One-time joining bonus in INR thousands
  bondMonths   Int?     // Service agreement length
  notes        String?  @db.VarChar(1000)
  helpfulCount Int      @default(0)
  status       CommunityPostStatus @default(ACTIVE)
  createdAt    DateTime @default(now())

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  helpfulMarks SalaryReportHelpful[]

  @@index([company])
  @@index([opportunityId])
  @@index([authorId])
  @@index([status, createdAt(sort: Desc)])
}

model SalaryReportHelpful {
  id             String @id @default(cuid())
  salaryReportId String
  userId         String
  createdAt      DateTime @default(now())

  report SalaryReport @relation(fields: [salaryReportId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([salaryReportId, userId])
  @@index([userId])
}
