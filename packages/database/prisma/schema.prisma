  role        String?  @db.VarChar(120)
  batch       Int?
  city        String?  @db.VarChar(80)
  note        String?  @db.VarChar(1000)
  status      ReferralRequestStatus @default(OPEN)
  responseCount Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User              @relation("ReferralRequestAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  responses ReferralResponse[]

  @@index([company])
  @@index([status, createdAt(sort: Desc)])
  @@index([authorId])
}

model ReferralResponse {
  id              String   @id @default(cuid())
  requestId       String
  responderId     String
  message         String?  @db.VarChar(1000)
  contactHandle   String?  @db.VarChar(200) // email / LinkedIn / Telegram handle shared by responder
  createdAt       DateTime @default(now())

  request ReferralRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responder User          @relation("ReferralResponseAuthor", fields: [responderId], references: [id], onDelete: Cascade)

  @@unique([requestId, responderId])
  @@index([responderId])
}

enum SalaryReportType {
  OFFER
  CURRENT_CTC
}

model SalaryReport {
  id           String   @id @default(cuid())
  authorId     String
  opportunityId String?
  company      String   @db.VarChar(120)
  role         String   @db.VarChar(120)
  batch        Int?
  city         String?  @db.VarChar(80)
  reportType   SalaryReportType @default(OFFER)
  ctcFixed     Int?     // Fixed pay in INR thousands (e.g. 350 = 3.5 LPA)
  ctcVariable  Int?     // Variable/bonus in INR thousands
  ctcTotal     Int?     // Stated CTC in INR thousands
  inHandMonthly Int?    // Take-home per month in INR
  joinBonus    Int?     // One-time joining bonus in INR thousands
  bondMonths   Int?     // Service agreement length
  notes        String?  @db.VarChar(1000)
  helpfulCount Int      @default(0)
  status       CommunityPostStatus @default(ACTIVE)
  createdAt    DateTime @default(now())

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  helpfulMarks SalaryReportHelpful[]

  @@index([company])
  @@index([opportunityId])
  @@index([authorId])
  @@index([status, createdAt(sort: Desc)])
}

model SalaryReportHelpful {
  id             String @id @default(cuid())
  salaryReportId String
  userId         String
  createdAt      DateTime @default(now())

  report SalaryReport @relation(fields: [salaryReportId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([salaryReportId, userId])
  @@index([userId])
}
