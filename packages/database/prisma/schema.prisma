model CommentVote {
  id        String           @id @default(cuid())
  commentId String
  userId    String
  value     CommentVoteValue
  createdAt DateTime         @default(now())

  comment OpportunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

model JobSignal {
  id            String        @id @default(cuid())
  opportunityId String
  userId        String
  signalType    JobSignalType
  createdAt     DateTime      @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId, signalType])
  @@index([opportunityId, signalType])
}

model JobSubmission {
  id            String              @id @default(cuid())
  sourceUrl     String
  applyUrl      String?
  title         String
  company       String?
  description   String?             @db.Text
  extractedData Json?
  status        JobSubmissionStatus @default(PENDING_REVIEW)
  submittedById String
  opportunityId String?
  createdAt     DateTime            @default(now())

  submittedBy User         @relation("JobSubmissions", fields: [submittedById], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([sourceUrl])
  @@index([submittedById])
}

model Report {
  id            String       @id @default(cuid())
  reporterId    String
  opportunityId String?
  commentId     String?
  reason        ReportReason
  message       String?      @db.VarChar(1000)
  status        ReportStatus @default(OPEN)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())

   reporter    User                @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
   resolvedBy  User?               @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
   opportunity Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
   comment     OpportunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
   communityPosts CommunityPost[]
   communityPostComments CommunityPostComment[]

  @@index([status, createdAt])
  @@index([reporterId])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  type          NotificationType
  actorId       String?
  opportunityId String?
  commentId     String?
  payload       Json?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  user        User                @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor       User?               @relation("NotificationsActed", fields: [actorId], references: [id], onDelete: SetNull)
  opportunity Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  comment     OpportunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model ResourceCollection {
  id              String             @id @default(uuid())
  title           String
  description     String?
  company         String?
  skills          String[]           @default([])
  tags            String[]           @default([])
  addedByUserId   String?
  addedByUsername String?
