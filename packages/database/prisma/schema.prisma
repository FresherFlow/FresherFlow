// ============================================================================
// ORGANIZATION & RECRUITER DOMAIN MODELS
// ============================================================================

enum OrganizationType {
  COMPANY
  ENGINEERING_COLLEGE
  TRAINING_INSTITUTE
  BOOTCAMP
  NGO
  PLACEMENT_CELL
}

enum OrgRole {
  OWNER
  ADMIN
  RECRUITER
  VIEWER
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  type         OrganizationType @default(COMPANY)
  website      String?
  emailDomain  String?
  logo         String?
  verified     Boolean          @default(false)
  verifiedAt   DateTime?
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  members      OrganizationMembership[]
  invites      OrganizationInvite[]
  interests    CandidateInterest[]
  // Listings this organisation owns and can manage.
  opportunities Opportunity[] @relation("OrganizationOpportunities")
  // The hiring process this organisation runs, reusable across its listings.
  pipelines     HiringPipeline[] @relation("OrganizationPipelines")
  // A college account points at its canonical Institution record, so campus
  // targeting has one source of truth instead of two competing ones.
  institutionId String?       @unique
  institution   Institution?  @relation("OrganizationInstitution", fields: [institutionId], references: [id], onDelete: SetNull)
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole          @default(RECRUITER)
  status         MembershipStatus @default(APPROVED)
  invitedBy      String?
  joinedAt       DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationInvite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole   @default(RECRUITER)
  invitedBy      String
  token          String    @unique @default(cuid())
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
}

