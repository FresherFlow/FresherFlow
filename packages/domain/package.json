{
  "name": "@fresherflow/domain",
  "version": "1.0.0",
  "description": "Core business domain logic for FresherFlow",
  "type": "module",
  "main": "./dist/index.js",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-esm-imports.mjs dist",
    "dev": "tsc -w",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fresherflow/constants": "^1.0.0",
    "@fresherflow/logger": "^1.0.0",
    "@fresherflow/types": "^1.0.0",
    "@fresherflow/utils": "^1.0.0",
    "country-state-city": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
