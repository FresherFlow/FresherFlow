{
  "name": "@fresherflow/utils",
  "version": "1.0.0",
  "description": "Shared utilities for FresherFlow",
  "type": "module",
  "main": "./dist/index.js",
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json ",
    "dev": "tsc -w",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@fresherflow/constants": "^1.0.0",
    "@fresherflow/types": "^1.0.0",
    "chalk": "^4.1.2",
    "compromise": "^14.16.0",
    "jsonwebtoken": "^9.0.2",
    "natural": "^8.1.1",
    "winston": "^3.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.2",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
