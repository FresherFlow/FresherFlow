{
  "name": "@fresherflow/pipeline",
  "version": "1.0.0",
  "description": "Shared pipeline and parsing logic for FresherFlow",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-imports.mjs dist",
    "dev": "tsc -w",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@fresherflow/constants": "workspace:*",
    "@fresherflow/parser": "workspace:*",
    "@fresherflow/plugins": "workspace:*",
    "@fresherflow/types": "workspace:*",
    "@fresherflow/utils": "workspace:*",
    "@google/genai": "^2.15.0",
    "cheerio": "^1.0.0",
    "html-to-text": "^9.0.5",
    "playwright": "^1.62.1",
    "zod": "^4.4.3",
    "@fresherflow/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/html-to-text": "^9.0.1",
    "typescript": "^5.7.3"
  }
}